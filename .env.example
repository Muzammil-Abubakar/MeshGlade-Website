# ─────────────────────────────────────────────────────────────
# Meshglade — environment variables
# Copy this file to `.env.local` and fill in your secrets.
#   cp .env.example .env.local
# `.env.local` is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO, Open Graph and email images)
NEXT_PUBLIC_SITE_URL=https://meshglade.com

# ── Google SMTP (Gmail / Google Workspace) ───────────────────
# 1. Turn on 2-Step Verification for the Google account
# 2. Create an App Password: Google Account → Security → App passwords
# 3. Paste the 16-character app password below (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where new leads are delivered (defaults to the email in content/site.ts)
MAIL_TO=
# Sender shown on emails — must be SMTP_USER or a verified "Send mail as" alias
MAIL_FROM="Meshglade <you@yourdomain.com>"
